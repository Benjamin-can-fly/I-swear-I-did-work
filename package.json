{
  "name": "work-journal",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/core.test.js tests/task-record.test.js tests/delete-entry.test.js tests/report.test.js",
    "test:ui": "node tests/browser.mjs",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "test:webkit": "node tests/cross-platform-ui.mjs",
    "test:drafts": "node tests/draft-recovery-ui.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "license": "MIT",
  "description": "A local-first work journal for people who say “I’ll remember this” and absolutely won’t. Record your work, review progress, manage tasks, and organize your timeline.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benjamin-can-fly/work-journal.git"
  },
  "homepage": "https://github.com/Benjamin-can-fly/work-journal",
  "bugs": {
    "url": "https://github.com/Benjamin-can-fly/work-journal/issues"
  },
  "keywords": [
    "work-log",
    "journal",
    "todo",
    "task-management",
    "timeline",
    "pdf-export",
    "local-first",
    "windows",
    "macos"
  ]
}
